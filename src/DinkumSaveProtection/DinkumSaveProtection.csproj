    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(GamePath)\Dinkum_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(GamePath)\Dinkum_Data\Managed\Mirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FizzySteamworks"><HintPath>$(GamePath)\Dinkum_Data\Managed\FizzySteamworks.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Steamworks.NET"><HintPath>$(GamePath)\Dinkum_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
